rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function normalizedAuthEmail() {
      return authEmail().lower();
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function userKeysValid() {
      return request.resource.data.keys().hasOnly([
        'email',
        'normalizedEmail',
        'partnerId',
        'partnerEmail',
        'coupleId',
        'displayName',
        'notificationPrivacy',
        'quickTipsEnabled',
        'adultConfirmedAt',
        'privacyAcceptedAt',
        'safetyAcceptedAt',
        'onboardingCompletedAt',
        'revealSeenCoupleId',
        'updatedAt',
        'lastSeenAt'
      ]);
    }

    function userProfileFieldsValid() {
      return (
          request.resource.data.displayName == null
          || request.resource.data.displayName is string
        )
        && (
          request.resource.data.notificationPrivacy == null
          || request.resource.data.notificationPrivacy == 'detailed'
          || request.resource.data.notificationPrivacy == 'discreet'
          || request.resource.data.notificationPrivacy == 'off'
        )
        && (
          request.resource.data.quickTipsEnabled == null
          || request.resource.data.quickTipsEnabled is bool
        )
        && (
          request.resource.data.adultConfirmedAt == null
          || request.resource.data.adultConfirmedAt is timestamp
        )
        && (
          request.resource.data.privacyAcceptedAt == null
          || request.resource.data.privacyAcceptedAt is timestamp
        )
        && (
          request.resource.data.safetyAcceptedAt == null
          || request.resource.data.safetyAcceptedAt is timestamp
        )
        && (
          request.resource.data.onboardingCompletedAt == null
          || request.resource.data.onboardingCompletedAt is timestamp
        )
        && (
          request.resource.data.revealSeenCoupleId == null
          || request.resource.data.revealSeenCoupleId is string
        );
    }

    function isOwnProfileBaseWrite(userId) {
      return isOwner(userId)
        && userKeysValid()
        && userProfileFieldsValid()
        && request.resource.data.email == authEmail()
        && request.resource.data.normalizedEmail == normalizedAuthEmail();
    }

    function hasRelationshipFieldsCleared(data) {
      return data.partnerId == null
        && data.partnerEmail == null
        && data.coupleId == null;
    }

    function isOwnProfileCreate(userId) {
      return isOwnProfileBaseWrite(userId)
        && hasRelationshipFieldsCleared(request.resource.data);
    }

    function isOwnProfileRoutineUpdate(userId) {
      return isOwnProfileBaseWrite(userId)
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.partnerEmail == resource.data.partnerEmail
        && request.resource.data.coupleId == resource.data.coupleId;
    }

    function isInviteViewer() {
      return isVerifiedUser()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.normalizedToEmail == normalizedAuthEmail()
        );
    }

    function isCoupleMember(coupleId) {
      return isVerifiedUser()
        && get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds.hasAny([request.auth.uid]);
    }

    function mirrorMessageKeysValid() {
      return request.resource.data.keys().hasOnly([
        'text',
        'strokes',
        'senderId',
        'senderEmail',
        'noteType',
        'tags',
        'promptId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function mirrorMessageFieldsValid() {
      return request.resource.data.noteType is string
        && (
          request.resource.data.noteType == 'warm'
          || request.resource.data.noteType == 'playful'
          || request.resource.data.noteType == 'reassuring'
          || request.resource.data.noteType == 'grateful'
          || request.resource.data.noteType == 'desire'
        )
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.tags.hasOnly([
          'repair',
          'flirty',
          'reconnection',
          'gratitude',
          'support',
          'desire',
          'affirmation',
          'daily',
          'softness'
        ])
        && (
          request.resource.data.promptId == null
          || request.resource.data.promptId is string
        );
    }

    function calendarEventKeysValid() {
      return request.resource.data.keys().hasOnly([
        'title',
        'note',
        'startsAt',
        'endsAt',
        'allDay',
        'foodQuery',
        'foodInterestFor',
        'restaurantPlaceId',
        'restaurantName',
        'restaurantAddress',
        'restaurantLatitude',
        'restaurantLongitude',
        'status',
        'createdByUserId',
        'createdByEmail',
        'createdAt',
        'updatedAt'
      ]);
    }

    function calendarEventFieldsValid() {
      return calendarEventKeysValid()
        && request.resource.data.title is string
        && request.resource.data.note is string
        && request.resource.data.startsAt is timestamp
        && (
          request.resource.data.endsAt == null
          || request.resource.data.endsAt is timestamp
        )
        && request.resource.data.allDay is bool
        && request.resource.data.foodQuery is string
        && request.resource.data.foodInterestFor is string
        && request.resource.data.foodInterestFor in ['me', 'partner', 'both']
        && (
          request.resource.data.restaurantPlaceId == null
          || request.resource.data.restaurantPlaceId is string
        )
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantAddress is string
        && (
          request.resource.data.restaurantLatitude == null
          || request.resource.data.restaurantLatitude is int
          || request.resource.data.restaurantLatitude is float
        )
        && (
          request.resource.data.restaurantLongitude == null
          || request.resource.data.restaurantLongitude is int
          || request.resource.data.restaurantLongitude is float
        )
        && (
          (request.resource.data.restaurantLatitude == null && request.resource.data.restaurantLongitude == null)
          || (request.resource.data.restaurantLatitude != null && request.resource.data.restaurantLongitude != null)
        )
        && request.resource.data.status in ['active', 'cancelled'];
    }

    function loveActionKeysValid() {
      return request.resource.data.keys().hasOnly([
        'title',
        'area',
        'preferenceId',
        'notes',
        'importance',
        'frequency',
        'timing',
        'customTiming',
        'visibility',
        'status',
        'nextDueAt',
        'lastCompletedAt',
        'respondedAt',
        'respondedByUserId',
        'respondedByEmail',
        'confirmationReaction',
        'confirmationNote',
        'appreciationReaction',
        'appreciationNote',
        'proposedByUserId',
        'proposedByEmail',
        'responsibleUserId',
        'responsibleUserEmail',
        'recipientUserId',
        'recipientUserEmail',
        'createdAt',
        'updatedAt'
      ]);
    }

    function loveActionFieldsValid() {
      return loveActionKeysValid()
        && request.resource.data.title is string
        && request.resource.data.area is string
        && request.resource.data.notes is string
        && request.resource.data.importance is string
        && request.resource.data.frequency is string
        && request.resource.data.timing is string
        && request.resource.data.visibility is string
        && request.resource.data.status is string
        && (
          request.resource.data.preferenceId == null
          || request.resource.data.preferenceId is string
        )
        && (
          request.resource.data.customTiming == null
          || request.resource.data.customTiming is string
        )
        && (
          request.resource.data.nextDueAt == null
          || request.resource.data.nextDueAt is timestamp
        )
        && (
          request.resource.data.lastCompletedAt == null
          || request.resource.data.lastCompletedAt is timestamp
        )
        && (
          request.resource.data.respondedAt == null
          || request.resource.data.respondedAt is timestamp
        )
        && (
          request.resource.data.respondedByUserId == null
          || request.resource.data.respondedByUserId is string
        )
        && (
          request.resource.data.respondedByEmail == null
          || request.resource.data.respondedByEmail is string
        )
        && (
          request.resource.data.confirmationReaction == null
          || request.resource.data.confirmationReaction is string
        )
        && request.resource.data.confirmationNote is string
        && (
          request.resource.data.appreciationReaction == null
          || request.resource.data.appreciationReaction is string
        )
        && request.resource.data.appreciationNote is string
        && request.resource.data.proposedByUserId == request.auth.uid
        && request.resource.data.proposedByEmail == authEmail()
        && request.resource.data.responsibleUserId == request.auth.uid
        && request.resource.data.responsibleUserEmail == authEmail()
        && request.resource.data.recipientUserId == request.auth.uid
        && request.resource.data.recipientUserEmail == authEmail()
        && (
          request.resource.data.respondedByUserId == null
          || request.resource.data.respondedByUserId == request.auth.uid
        )
        && (
          request.resource.data.respondedByEmail == null
          || request.resource.data.respondedByEmail == authEmail()
        )
        && request.resource.data.area in [
          'emotional',
          'physicalIntimate',
          'communication',
          'financial',
          'spiritual',
          'mental',
          'social',
          'partnership'
        ]
        && request.resource.data.importance in ['low', 'medium', 'high', 'essential']
        && request.resource.data.frequency in [
          'daily',
          'severalTimesWeekly',
          'weekly',
          'monthly',
          'occasionally',
          'surpriseMe'
        ]
        && request.resource.data.timing in ['morning', 'evening', 'weekend', 'anytime', 'custom']
        && request.resource.data.visibility in ['private', 'shared', 'surprise']
        && request.resource.data.status in [
          'proposed',
          'scheduled',
          'due',
          'performed',
          'confirmed',
          'appreciated',
          'needsAttention',
          'cancelled'
        ];
    }

    function insightKeysValid() {
      return request.resource.data.keys().hasOnly([
        'mood',
        'connection',
        'tension',
        'appreciation',
        'need',
        'reflection',
        'nextStep',
        'visibility',
        'sharedInsightId',
        'createdByUserId',
        'createdByEmail',
        'createdAt',
        'updatedAt'
      ]);
    }

    function insightBaseValid() {
      return insightKeysValid()
        && request.resource.data.mood is int
        && request.resource.data.connection is int
        && request.resource.data.tension is int
        && request.resource.data.mood >= 1
        && request.resource.data.mood <= 5
        && request.resource.data.connection >= 1
        && request.resource.data.connection <= 5
        && request.resource.data.tension >= 1
        && request.resource.data.tension <= 5
        && request.resource.data.appreciation is string
        && request.resource.data.need is string
        && request.resource.data.reflection is string
        && request.resource.data.nextStep is string
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.createdByEmail == authEmail()
        && (
          request.resource.data.sharedInsightId == null
          || request.resource.data.sharedInsightId is string
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwnProfileCreate(userId);
      allow update: if isOwnProfileRoutineUpdate(userId);
      allow delete: if false;

      match /lovePreferences/{preferenceId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /mirrorMessages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && mirrorMessageKeysValid()
          && mirrorMessageFieldsValid()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderEmail == authEmail();
        allow update: if false;
        allow delete: if isOwner(userId)
          && resource.data.senderId == request.auth.uid;
      }

      match /calendarEvents/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && calendarEventFieldsValid()
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.createdByEmail == authEmail()
          && request.resource.data.status == 'active';
        allow update: if isOwner(userId)
          && calendarEventFieldsValid()
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && request.resource.data.createdByEmail == resource.data.createdByEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == resource.data.status;
        allow delete: if isOwner(userId);
      }

      match /loveActions/{actionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && loveActionFieldsValid();
        allow update: if isOwner(userId)
          && loveActionFieldsValid()
          && request.resource.data.proposedByUserId == resource.data.proposedByUserId
          && request.resource.data.proposedByEmail == resource.data.proposedByEmail
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      match /insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && insightBaseValid()
          && (
            request.resource.data.visibility == 'private'
            || request.resource.data.visibility == 'decideLater'
            || request.resource.data.visibility == 'shared'
          );
        allow update: if isOwner(userId)
          && insightBaseValid()
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && request.resource.data.createdByEmail == resource.data.createdByEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.visibility == 'private'
            || request.resource.data.visibility == 'decideLater'
            || request.resource.data.visibility == 'shared'
          );
        allow delete: if isOwner(userId);
      }
    }

    match /partnerInvites/{inviteId} {
      allow read: if isInviteViewer();
      allow create, update, delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if isVerifiedUser() && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create, update, delete: if false;

      match /mirrorMessages/{messageId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && mirrorMessageKeysValid()
          && mirrorMessageFieldsValid()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderEmail == authEmail();
        allow update: if false;
        allow delete: if isCoupleMember(coupleId)
          && resource.data.senderId == request.auth.uid;
      }

      match /calendarEvents/{eventId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && calendarEventFieldsValid()
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.createdByEmail == authEmail()
          && request.resource.data.status == 'active';
        allow update: if isCoupleMember(coupleId)
          && calendarEventFieldsValid()
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && request.resource.data.createdByEmail == resource.data.createdByEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == resource.data.status;
        allow delete: if isCoupleMember(coupleId);
      }

      match /loveActions/{actionId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update, delete: if false;
      }

      match /preferenceReveals/{userId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update, delete: if false;
      }

      match /metricSnapshots/{snapshotId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update, delete: if false;
      }

      match /insights/{insightId} {
        allow read: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId)
          && insightBaseValid()
          && request.resource.data.visibility == 'shared';
        allow update: if isCoupleMember(coupleId)
          && resource.data.createdByUserId == request.auth.uid
          && insightBaseValid()
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && request.resource.data.createdByEmail == resource.data.createdByEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.visibility == 'shared';
        allow delete: if isCoupleMember(coupleId)
          && resource.data.createdByUserId == request.auth.uid;
      }
    }
  }
}
